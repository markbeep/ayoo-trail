  <node id="2" lat="47.0000" lon="8.0100"/>
  <node id="3" lat="47.0100" lon="8.0100"/>
  <node id="4" lat="47.0100" lon="8.0000"/>
  <!-- inner square -->
  <node id="5" lat="47.0040" lon="8.0040"/>
  <node id="6" lat="47.0040" lon="8.0060"/>
  <node id="7" lat="47.0060" lon="8.0060"/>
  <node id="8" lat="47.0060" lon="8.0040"/>
  <!-- meadow triangle -->
  <node id="9" lat="47.0200" lon="8.0000"/>
  <node id="10" lat="47.0200" lon="8.0100"/>
  <node id="11" lat="47.0300" lon="8.0000"/>
