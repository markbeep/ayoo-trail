  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Find loops: the one signal-red action; unavailable state when no start is set.",
      "html": "<div style=\"display:grid;gap:8px;width:240px\"><button class=\"ds-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Find loops</button><button class=\"ds-primary\" disabled>Find loops</button></div>",
      "css": ".ds-primary{font-family:Archivo,system-ui,sans-serif;display:flex;align-items:center;justify-content:center;gap:8px;width:100%;min-height:38px;border:0;border-radius:0;background:var(--signal,#d5281b);color:#fff;font-weight:800;font-size:15px;cursor:pointer;transition:background-color .15s}.ds-primary:hover,.ds-primary:active{background:var(--signal-deep,#a91d12)}.ds-primary:focus-visible{outline:2px solid #141414;outline-offset:1px}.ds-primary:disabled{cursor:not-allowed;background:#efefea;color:#5b5b56;border:1px solid #dcdcd6}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segment",
      "description": "Distance presets and climb choice: equal cells in an ink frame, on = inverted.",
      "html": "<div class=\"ds-seg\"><button>10</button><button class=\"on\">15</button><button>21</button><button>30</button></div>",
      "css": ".ds-seg{display:flex;width:240px;border:1px solid #141414}.ds-seg>button{font-family:Archivo,system-ui,sans-serif;flex:1;min-height:30px;border:0;background:none;font-weight:700;font-size:13px;color:#141414;cursor:pointer;transition:background-color .12s,color .12s}.ds-seg>*+*{border-left:1px solid #dcdcd6}.ds-seg>button:hover{background:#efefea}.ds-seg>button.on{background:#141414;color:#fbfbf8}.ds-seg>button:focus-visible{outline:2px solid #141414;outline-offset:1px}"
    },
    {
      "name": "Loops Table",
      "kind": "custom",
      "refersTo": "loop-row",
      "description": "Timetable rows with visible column rules; the selected loop is inverted.",
      "html": "<div class=\"ds-tiles\"><div class=\"ds-head\"><span>Loop</span><span>km</span><span>↑ m</span><span>score</span></div><button class=\"ds-tile on\"><b>Loop A</b><span>15.0</span><span>910</span><b class=\"sc\">93</b></button><button class=\"ds-tile\"><b>Loop B</b><span>14.9</span><span>935</span><b class=\"sc\">92</b></button></div>",
      "css": ".ds-tiles{display:grid;width:380px;background:#fbfbf8;border-bottom:1px solid #141414;font-variant-numeric:tabular-nums}.ds-head,.ds-tile{font-family:Archivo,system-ui,sans-serif;display:grid;grid-template-columns:1fr 64px 64px 52px;min-height:28px;padding:0 12px;text-align:left;border:0;color:#141414}.ds-head>*,.ds-tile>*{display:flex;align-items:center}.ds-head>*:not(:first-child),.ds-tile>*:not(:first-child){justify-content:flex-end;padding-right:6px;border-left:1px solid #dcdcd6}.ds-head{font-family:'Archivo Narrow',Archivo,system-ui,sans-serif;min-height:22px;font-weight:700;font-size:12px;color:#5b5b56;background:#efefea;border-bottom:1px solid #141414}.ds-tile{background:#fbfbf8;font-size:13px;font-weight:600;border-bottom:1px solid #dcdcd6;cursor:pointer}.ds-tile b{font-weight:800}.ds-tile:hover{background:#efefea}.ds-tile.on{background:#141414;color:#fbfbf8}.ds-tile.on>*:not(:first-child){border-left-color:#3a3a38}.ds-tile.on .sc{color:#ff6a5c}.ds-tile:focus-visible{outline:2px solid #141414;outline-offset:1px}"
    },
    {
      "name": "Settings Row with Scrub Field",
      "kind": "input",
      "refersTo": "scrub-field",
      "description": "Term, acts-on, a drag-or-type multiplier on a stone well, and the effect word.",
      "html": "<div class=\"ds-set\"><div class=\"ds-group\">Preferences <span>below ×1 prefers, above avoids</span></div><div class=\"ds-row\"><span class=\"l\">Surface</span><span class=\"o\">asphalt</span><span><span class=\"ds-scrub\" tabindex=\"0\">×2</span></span><span class=\"n avoid\">avoid</span></div><div class=\"ds-row\"><span class=\"l\">Forest</span><span class=\"o\">full forest</span><span><span class=\"ds-scrub\" tabindex=\"0\">×0.9</span></span><span class=\"n prefer\">prefer</span></div></div>",
      "css": ".ds-set{font-family:Archivo,system-ui,sans-serif;width:380px;background:#fbfbf8;color:#141414;font-variant-numeric:tabular-nums}.ds-group{display:flex;gap:8px;align-items:baseline;font-size:12px;font-weight:800;padding:3px 12px 2px;background:#efefea;border-bottom:1px solid #141414}.ds-group span{font-family:'Archivo Narrow',Archivo,system-ui,sans-serif;font-weight:400;color:#5b5b56}.ds-row{display:grid;grid-template-columns:104px 1fr 84px 52px;min-height:28px;font-size:13px;padding:0 12px;border-bottom:1px solid #dcdcd6}.ds-row>*{display:flex;align-items:center;min-width:0}.ds-row>*+*{border-left:1px solid #dcdcd6;padding-left:6px}.ds-row .l{font-weight:700}.ds-row .o{color:#5b5b56}.ds-row .n{justify-content:flex-end;font-weight:600;font-size:12px}.avoid{color:#a3231a}.prefer{color:#1f6b3a}.ds-scrub{display:inline-block;width:100%;padding:2px 6px;text-align:right;font-weight:800;background:#efefea;border:1px solid transparent;cursor:ew-resize;user-select:none}.ds-scrub:hover{border-color:#141414}.ds-scrub:focus-visible{outline:2px solid #141414;outline-offset:-2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "description": "Stone-well text field; focus turns paper with an ink border, caret signal red.",
      "html": "<label class=\"ds-field\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M20 10c0 5-8 12-8 12s-8-7-8-12a8 8 0 0 1 16 0Z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg><input placeholder=\"Pick a start\"></label>",
      "css": ".ds-field{font-family:Archivo,system-ui,sans-serif;display:flex;align-items:center;gap:8px;width:280px;min-height:34px;padding:0 8px;background:#efefea;border:1px solid #dcdcd6;color:#5b5b56;transition:background-color .15s,border-color .15s}.ds-field:hover{border-color:#141414}.ds-field:focus-within{background:#fbfbf8;border-color:#141414;color:#141414}.ds-field input{flex:1;min-width:0;height:32px;border:0;background:transparent;font:inherit;font-weight:700;color:#141414;caret-color:#d5281b;outline:none}.ds-field input::placeholder{color:#5b5b56;font-weight:500}"
